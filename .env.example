# Moonwing application environment
# Copy to .env on the manager host and fill in real values.
# All settings use the MOONWING_ prefix and are loaded by pydantic-settings.

# ── Core ──────────────────────────────────────────────────────────────
MOONWING_APP_NAME=moonwing
MOONWING_DATABASE_URL=postgresql+psycopg://moonwing:moonwing@postgres:5432/moonwing
MOONWING_QUEUE_BACKEND=redis://redis:6379/0
MOONWING_WORKSPACE_DIR=/var/lib/moonwing/workspace/runs

# ── Object storage (MinIO/S3) ─────────────────────────────────────────
MOONWING_OBJECT_STORAGE_ENDPOINT=minio:9000
MOONWING_OBJECT_STORAGE_BUCKET=moonwing-artifacts
MOONWING_OBJECT_STORAGE_ACCESS_KEY=minio
MOONWING_OBJECT_STORAGE_SECRET_KEY=change-me-in-prod
MOONWING_OBJECT_STORAGE_SECURE=false

# ── Clearwing / AI runtimes ───────────────────────────────────────────
MOONWING_CLEARWING_BINARY=clearwing
MOONWING_CLAUDE_CLI_BINARY=claude
MOONWING_CODEX_CLI_BINARY=codex
MOONWING_GEMINI_CLI_BINARY=gemini
# Sent with OpenRouter requests (public URL of your deployment or product page).
# MOONWING_OPENROUTER_HTTP_REFERER=https://moonwing.example.org
# Fernet key for credential.encrypted_api_key column.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MOONWING_ENCRYPTION_KEY=

# ── Sessions ──────────────────────────────────────────────────────────
# Random 64+ byte secret. NEVER ship the default to production.
MOONWING_SESSION_SECRET=moonwing-dev-session-secret-change-me

# ── First-run / bootstrap admin ───────────────────────────────────────
# Used only on initial DB bootstrap; safe to leave at defaults if first
# run has already completed.
MOONWING_BOOTSTRAP_ADMIN_EMAIL=admin
MOONWING_BOOTSTRAP_ADMIN_PASSWORD=admin
MOONWING_BOOTSTRAP_ADMIN_DISPLAY_NAME=Bootstrap Admin

# ── OIDC (Authentik) ──────────────────────────────────────────────────
# Keep client secrets out of Git (env, vault, or your secrets manager).
MOONWING_OIDC_AUTHORIZATION_ENDPOINT=
MOONWING_OIDC_TOKEN_ENDPOINT=
MOONWING_OIDC_USERINFO_ENDPOINT=
MOONWING_OIDC_ISSUER=
MOONWING_OIDC_CLIENT_ID=
MOONWING_OIDC_CLIENT_SECRET=
MOONWING_OIDC_REDIRECT_URI=https://moonwing.example.com/auth/oidc/callback
MOONWING_OIDC_SCOPE=openid email profile
MOONWING_OIDC_DEFAULT_ROLE=viewer

# ── Sensor enrollment ─────────────────────────────────────────────────
# Shared bearer token endpoints present at /api/sensors/enroll.
# Keep the token outside Git (vault or equivalent).
MOONWING_SENSOR_ENROLLMENT_TOKEN=

# ── In-app Moonwing upgrades (admin only) ─────────────────────────────
# Live manager must point at a git checkout with working remotes.
# Ansible rsync often omits .git — keep a clone on the host or pull manually.
MOONWING_UPDATE_REPO_PATH=/opt/moonwing/app
MOONWING_UPDATE_GIT_REMOTE=origin
MOONWING_UPDATE_GIT_BRANCH=main
# Optional: lock pip/alembic to the service venv (defaults: <repo>/venv/bin/python)
MOONWING_UPDATE_VENV_PYTHON=
# Optional: public GitHub compare when .git is missing (owner/repo)
MOONWING_UPDATE_GITHUB_REPOSITORY=
MOONWING_UPDATE_GITHUB_BRANCH=main
# Comma-separated systemd units to restart after upgrade (Linux). Start with
# worker only if you want the API to keep serving the response:
#   MOONWING_UPDATE_SYSTEMD_UNITS=moonwing-worker
MOONWING_UPDATE_SYSTEMD_UNITS=moonwing-api,moonwing-worker
MOONWING_UPDATE_PIP_TIMEOUT_SECONDS=600
MOONWING_UPDATE_ALEMBIC_TIMEOUT_SECONDS=300
