# Copy to /etc/default/moonwing-auto-upgrade on secops (192.168.1.215).
# Then uncomment EnvironmentFile in moonwing-auto-upgrade.service and: systemctl daemon-reload

MOONWING_UPGRADE_REPO=/opt/moonwing/Moonwing
MOONWING_GIT_BRANCH=main
MOONWING_COMPOSE_OVERLAY=deploy/secops/docker-compose.secops.yml
